{
  "name": "procedural-texture-lab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": {
    "./runtime": {
      "types": "./dist-runtime/types/runtime/index.d.ts",
      "import": "./dist-runtime/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:runtime",
    "build:runtime": "tsc --noEmit && vite build --config vite.runtime.config.ts && tsc -p tsconfig.runtime.json",
    "preview": "vite preview",
    "thumbnails:generate": "node scripts/generate-preset-thumbnails.mjs",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs && node scripts/renderer-fallback-smoke.mjs",
    "test:renderer-fallback": "node scripts/renderer-fallback-smoke.mjs",
    "test:production-export": "node scripts/production-export-smoke.mjs",
    "test:cross-browser": "node scripts/cross-browser-smoke.mjs",
    "test:runtime-package": "npm run build:runtime && node scripts/runtime-consumer-smoke.mjs",
    "test:visual": "npm run build && node scripts/visual-suite.mjs",
    "test:qa": "npm run test:unit && npm run build && node scripts/capture-qa.mjs",
    "qa:capture": "npm run test:unit && npm run build && node scripts/capture-qa.mjs",
    "ci": "npm run test:unit && npm run build && node scripts/runtime-consumer-smoke.mjs",
    "deploy": "node scripts/publish-gh-pages.mjs",
    "publish:gh": "node scripts/publish-gh-pages.mjs"
  },
  "dependencies": {
    "three": "0.185.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/three": "0.185.4",
    "gh-pages": "^6.3.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
